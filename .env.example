# Copy this file to ".env" and fill it in. Never commit ".env" and never share it.

# --- Sign-in (required) ---
ADMIN_EMAIL=you@example.com
# Make this with:  npm run hash-password -- "your long passphrase"   (paste the whole ADMIN_PASSWORD_HASH=... line)
ADMIN_PASSWORD_HASH=

# --- Server ---
PORT=3000
NODE_ENV=development
# Where the database file lives. Put it on persistent storage when deployed.
DB_PATH=data/crm.sqlite
# Public https address once deployed (used in reminder emails and cookie safety checks)
PUBLIC_BASE_URL=
# Behind a hosting proxy (Render, Fly, etc.) set to 1 so rate limits see real visitor IPs
TRUST_PROXY=
SESSION_DAYS=7

# --- Public quote page / tracking ---
# Your own website origin(s) allowed to call the tracking script endpoints, comma separated, e.g. https://www.example.com
PUBLIC_ALLOWED_ORIGINS=
# Leave false until you have decided on a privacy notice / consent approach for tracking.
TRACKING_ENABLED=false

# --- Reminder email (SMTP). Reminders are only ever sent to ADMIN_EMAIL. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REMINDER_TICK_SECONDS=300

# --- Fetch live quoting. KEEP false: no verified API documentation or access yet. ---
FETCH_LIVE_ENABLED=false

# On first start, fill empty settings from config/decisions.json (never overwrites later changes)
APPLY_DECISIONS_ON_START=false
