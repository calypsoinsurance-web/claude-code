{
  "name": "calypso-pet-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Private single-user pet insurance CRM and advertising dashboard (Calypso Insurance)",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "migrate": "node --disable-warning=ExperimentalWarning src/migrate-cli.js",
    "apply-decisions": "node --disable-warning=ExperimentalWarning scripts/apply-decisions.js",
    "hash-password": "node scripts/hash-password.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "demo": "DB_PATH=data/demo.sqlite node --disable-warning=ExperimentalWarning src/server.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.0"
  }
}
